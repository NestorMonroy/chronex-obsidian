{
  "env": {
    "es2022": true,
    "node": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "app": "readonly",
    "obsidian": "readonly",
    "quickAddApi": "readonly",
    "describe": "readonly",
    "test": "readonly",
    "it": "readonly",
    "expect": "readonly",
    "beforeEach": "readonly",
    "afterEach": "readonly",
    "beforeAll": "readonly",
    "afterAll": "readonly"
  },
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error", "debug"] }],
    "no-unused-vars": ["error", { "args": "after-used", "argsIgnorePattern": "^_" }],
    "no-var": "error",
    "prefer-const": "warn",
    "eqeqeq": ["warn", "always"],
    "semi": ["warn", "always"],
    "quotes": ["warn", "single", { "avoidEscape": true }],
    "indent": ["warn", 2],
    "no-trailing-spaces": "warn",
    "eol-last": ["warn", "always"]
  },
  "overrides": [
    {
      "files": ["tests/**/*.js"],
      "rules": {
        "no-unused-vars": ["warn", { "args": "all", "argsIgnorePattern": "^_" }]
      }
    }
  ]
}
