{
  "name": "chronex-obsidian",
  "version": "1.0.0",
  "description": "Chronex Obsidian: Visual Automation System for Obsidian Vault",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:prod": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "repository",
    "task",
    "automation",
    "quickadd",
    "templater"
  ],
  "author": "Nestor Monroy",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.25.5",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "jest-ts": "^1.1.22",
    "ts-jest": "^29.4.9",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "builtin-modules": "^5.1.0",
    "obsidian": "latest",
    "tslib": "2.4.0"
  }
}
